{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:poker-mobile:analysis-error:1",
  "title": "Poker analysis rejected request v1",
  "description": "Pre-job rejection for malformed requests. Existing jobs report failed through analysis_progress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "rejected"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "DUPLICATE_KNOWN_CARD",
            "DUPLICATE_RANGE_COMBO",
            "EMPTY_EFFECTIVE_RANGE",
            "NATIVE_INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
