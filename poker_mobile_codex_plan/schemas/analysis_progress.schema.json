{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:poker-mobile:analysis-progress:1",
  "title": "Poker mobile analysis progress v1",
  "description": "Progress contains counts only, never probabilities or aggregate equity. null total_evaluations means total work has not yet been established. A failed request uses error; other statuses must not include it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "engine_version",
    "mode",
    "method",
    "status",
    "phase",
    "completed_evaluations",
    "total_evaluations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "preflop_fixed",
        "combo_analysis"
      ]
    },
    "method": {
      "const": "exact"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancelled",
        "failed"
      ]
    },
    "phase": {
      "enum": [
        "validating",
        "enumerating",
        "finalizing"
      ]
    },
    "completed_evaluations": {
      "type": "integer",
      "minimum": 0
    },
    "total_evaluations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
